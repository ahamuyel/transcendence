# ─── Database ───────────────────────────────────────────────────────
# Remote (Neon):
DATABASE_URL=postgresql://user:password@host:5432/db?sslmode=require
# Local (uncomment for local PostgreSQL):
# DATABASE_URL=postgresql://cur10usx:cur10usx_dev@postgres:5432/cur10usx

# ─── Auth.js ────────────────────────────────────────────────────────
AUTH_SECRET=generate-with-openssl-rand-base64-32
AUTH_URL=http://localhost

# ─── Google OAuth ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_AUTH_ENABLED=false

# ─── Resend (Emails) ───────────────────────────────────────────────
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@cur10usx.dev

# ─── Vercel Blob (Uploads) ─────────────────────────────────────────
BLOB_READ_WRITE_TOKEN=

# ─── WebSocket ──────────────────────────────────────────────────────
# Browser connects via Nginx in production:
NEXT_PUBLIC_WS_URL=ws://localhost/ws
# Server-side connects directly to ws-server container:
WS_SERVER_URL=ws://ws-server:3001

# ─── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379

# ─── Deployment ────────────────────────────────────────────────────
DOMAIN=localhost
TAG=latest
